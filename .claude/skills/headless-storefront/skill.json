{
  "id": "headless-storefront",
  "version": "1.0.0",
  "category": "e-commerce",
  "keywords": [
    "shopify",
    "storefront-api",
    "headless",
    "react",
    "nextjs",
    "cart",
    "checkout"
  ],
  "semanticTags": {
    "primary": [
      "headless-commerce",
      "storefront",
      "customer-facing"
    ],
    "secondary": [
      "cart",
      "checkout",
      "products",
      "collections"
    ],
    "domains": [
      "e-commerce",
      "frontend"
    ]
  },
  "capabilities": {
    "inputs": [
      "storefront_access_token",
      "product_handles",
      "cart_data"
    ],
    "outputs": [
      "product_pages",
      "cart_ui",
      "collection_pages"
    ],
    "actions": [
      "fetch_products",
      "manage_cart",
      "redirect_to_checkout"
    ]
  },
  "orchestration": {
    "priority": 8,
    "cooperationLevel": "high",
    "parallelizable": true,
    "estimatedTokens": 2500,
    "activationThreshold": 0.75
  }
}