# Shopify Storefront API Configuration
# Ask a team member for the actual values

NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token
# Fera Product Reviews
NEXT_PUBLIC_FERA_PUBLIC_KEY=your-fera-public-key

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Shopify Webhook Verification
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# Resend - Transactional email (contact form)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Resend - Newsletter broadcasts (publish-broadcast script)
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL="CREATESPACE <info@thecreatespace.co.za>"
# Public base URL used to resolve image src in email templates (logo, illustrations).
# Must point to a host where /images/... is publicly reachable.
EMAIL_ASSET_BASE_URL=https://www.thecreatespace.co.za