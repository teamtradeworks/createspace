    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^6.4.1",
    "@eslint/css": "^0.14.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^5.85.0",
    "playwright": "^1.58.2",
    "postcss": "^8.4.33",
