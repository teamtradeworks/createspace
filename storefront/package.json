{
  "name": "createspace-storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"*.{js,mjs,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"*.{js,mjs,ts,json}\"",
    "knip": "knip",
    "lighthouse": "lhci autorun",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "email:dev": "email dev --dir emails",
    "newsletter:publish": "tsx scripts/publish-broadcast.tsx"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.47.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "fuse.js": "^7.3.0",
    "next": "^16.2.3",
    "posthog-js": "^1.365.5",
    "posthog-node": "^5.21.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "resend": "^6.10.0"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^6.6.1",
    "@eslint/css": "^1.1.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@react-email/ui": "^6.0.8",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^5.88.1",
    "playwright": "^1.58.2",
    "postcss": "^8.5.9",
    "prettier": "^3.8.1",
    "react-email": "^6.0.8",
    "tailwind-csstree": "^0.1.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  }
}
